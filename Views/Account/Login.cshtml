@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="games-header account-header">
    <div>
        <p class="screen-kicker">GameDex / Trainer Access</p>
        <h1>Sign In</h1>
    </div>
</div>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="dex-form account-form">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="account-form-grid">
        <div class="form-group">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
        </div>

        <label class="account-check">
            <input asp-for="RememberMe" class="account-check-input" />
            <span>@Html.DisplayNameFor(model => model.RememberMe)</span>
        </label>
    </div>

    <div class="dex-form-actions">
        <button type="submit" class="dex-button dex-button-primary">Sign in</button>
        <a asp-action="Register" class="dex-button dex-button-secondary">Create account</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}