@model IEnumerable<global::Game.Models.Game>

@{
    ViewData["Title"] = "Games";
}

<div class="games-header">
    <div>
        <p class="screen-kicker">GameDex Archive / Complete Registry</p>
        <h1>Game Index</h1>
        <p>@Model.Count() registered entries</p>
    </div>
    @if (User.IsInRole("RegistryAdmin"))
    {
        <a asp-action="Create" class="dex-button dex-button-primary">+ Register game</a>
    }
</div>

@if (!Model.Any())
{
    <section class="empty-dex">
        <span class="empty-dex-icon" aria-hidden="true"></span>
        <h2>No entries found</h2>
        <p>The registry is ready for its first game.</p>
        @if (User.IsInRole("RegistryAdmin"))
        {
            <a asp-action="Create" class="dex-button dex-button-primary">Create the first entry</a>
        }
    </section>
}
else
{
    <div class="game-grid">
        @foreach (var game in Model)
        {
            <article class="game-card">
                <div class="game-card-top">
                    <span>No. @game.Id.ToString("D3")</span>
                    <span class="game-card-status">Registered</span>
                </div>
                <h2>@game.Title</h2>
                <dl class="game-facts">
                    <div>
                        <dt>Region</dt>
                        <dd>@game.Region</dd>
                    </div>
                    <div>
                        <dt>Generation</dt>
                        <dd>@game.Generation</dd>
                    </div>
                    <div>
                        <dt>Platform</dt>
                        <dd>@game.Platform</dd>
                    </div>
                    <div>
                        <dt>Released</dt>
                        <dd>@game.ReleaseDate.ToString("MMM d, yyyy")</dd>
                    </div>
                </dl>
                <p class="game-description">@game.Description</p>
                <div class="game-card-footer">
                    <div>
                        <span class="fact-label">Developer</span>
                        <strong>@game.Developer</strong>
                    </div>
                    <a asp-action="Details" asp-route-id="@game.Id" class="detail-button" aria-label="View details for @game.Title">
                        Details <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>
            </article>
        }
    </div>
}

<script src="https://jgrissom.github.io/dotnet-web-dev/week-13/homework-checks.js"></script>