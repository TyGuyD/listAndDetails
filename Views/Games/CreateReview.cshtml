@model listAndDetails.ViewModels.ReviewFormViewModel

@{
    ViewData["Title"] = "Add Review";
}

<div class="games-header">
    <div>
        <p class="screen-kicker">GameDex Archive / Field Review</p>
        <h1>Add Review</h1>
    </div>
    <a asp-action="Details" asp-route-id="@Model.GameId" class="dex-button dex-button-secondary">&larr; Back to entry</a>
</div>

<form asp-action="CreateReview" class="dex-form review-form">
    <div class="form-grid">
    <div class="form-group">
        <label asp-for="GameId"></label>
        <select asp-for="GameId" asp-items="@(ViewData["Games"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)" class="form-control"></select>
        <span asp-validation-for="GameId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ReviewerName"></label>
        <input asp-for="ReviewerName" class="form-control" />
        <span asp-validation-for="ReviewerName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Rating"></label>
        <input asp-for="Rating" class="form-control" type="number" min="1" max="10" step="0.1" />
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>
    <div class="form-group form-group-full">
        <label asp-for="Comment"></label>
        <textarea asp-for="Comment" class="form-control"></textarea>
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>
    </div>
    <div class="dex-form-actions">
        <button type="submit" class="dex-button dex-button-primary">Submit review</button>
        <a asp-action="Details" asp-route-id="@Model.GameId" class="dex-button dex-button-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}