@model global::Game.Models.Game

@{
    ViewData["Title"] = "Delete";
}

<div class="games-header">
    <div>
        <p class="screen-kicker">GameDex Archive / Deletion Request</p>
        <h1>Delete Entry</h1>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="dex-button dex-button-secondary">&larr; Back to entry</a>
</div>

<section class="delete-panel">
    <p class="delete-warning">Confirm deletion</p>
    <h2>@Model.Title</h2>
    <p>Are you sure you want to permanently remove this game from the registry?</p>
    <dl class="delete-facts">
        <div><dt>Entry</dt><dd>No. @Model.Id.ToString("D3")</dd></div>
        <div><dt>Region</dt><dd>@Model.Region</dd></div>
        <div><dt>Platform</dt><dd>@Model.Platform</dd></div>
        <div><dt>Developer</dt><dd>@Model.Developer</dd></div>
    </dl>
    <form asp-action="Delete" class="dex-form-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="dex-button dex-button-danger">Delete permanently</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="dex-button dex-button-secondary">Cancel</a>
    </form>
</section>
