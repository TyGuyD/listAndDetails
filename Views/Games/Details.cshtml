@model Game.Models.Game

<h1>@Model.Title</h1>

<p><strong>Release Date:</strong> @Model.ReleaseDate.ToShortDateString()</p>
<p><strong>Generation:</strong> @Model.Generation</p>
<p><strong>Region:</strong> @Model.Region</p>
