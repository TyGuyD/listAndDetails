@model global::Game.Models.Game

@{
    ViewData["Title"] = Model.Title;
}

<div class="games-header">
    <div>
        <p class="screen-kicker">GameDex Entry / No. @Model.Id.ToString("D3")</p>
        <h1>@Model.Title</h1>
    </div>
    <a asp-action="Index" class="dex-button dex-button-secondary">&larr; Back to index</a>
</div>

<div class="details-layout">
    <section class="details-panel">
        <div class="details-panel-heading">
            <span>Entry data</span>
            <span class="status-chip">Registered</span>
        </div>
        <dl class="details-grid">
            <div><dt>Release date</dt><dd>@Model.ReleaseDate.ToString("MMMM d, yyyy")</dd></div>
            <div><dt>Generation</dt><dd>@Model.Generation</dd></div>
            <div><dt>Region</dt><dd>@Model.Region</dd></div>
            <div><dt>Platform</dt><dd>@Model.Platform</dd></div>
            <div><dt>Developer</dt><dd>@Model.Developer</dd></div>
            <div><dt>Director</dt><dd>@(string.IsNullOrWhiteSpace(Model.Director) ? "Not listed" : Model.Director)</dd></div>
        </dl>
        <div class="details-description">
            <span class="fact-label">Description</span>
            <p>@Model.Description</p>
        </div>
        <div class="details-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="dex-button dex-button-primary">Edit entry</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="dex-button dex-button-danger">Delete entry</a>
        </div>
    </section>

    <section class="reviews-panel">
        <div class="details-panel-heading">
            <span>Field reviews</span>
            <span>@Model.Reviews.Count() total</span>
        </div>
        @if (!Model.Reviews.Any())
        {
            <div class="empty-reviews">
                <p>No reviews have been logged for this entry.</p>
            </div>
        }
        else
        {
            <div class="review-list">
                @foreach (var review in Model.Reviews)
                {
                    <article class="review-card">
                        <div>
                            <strong>@review.ReviewerName</strong>
                            <span class="review-rating">@review.Rating.ToString("0.0") / 10</span>
                        </div>
                        <p>@review.Comment</p>
                    </article>
                }
            </div>
        }
        <a asp-action="CreateReview" asp-route-GameId="@Model.Id" class="dex-button dex-button-primary">Add review</a>
    </section>
</div>