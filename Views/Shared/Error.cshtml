@model listAndDetails.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="system-panel">
    <p class="delete-warning">System alert</p>
    <h1>Request error</h1>
    <p>An unexpected problem occurred while processing this request.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="dex-button dex-button-primary">Return home</a>
</section>
