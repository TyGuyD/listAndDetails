@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav pokedex-nav-list pokedex-account-list align-items-sm-center">
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link pokedex-button pokedex-account-button">Sign out</button>
        </form>
    </li>
    var user = await UserManager.GetUserAsync(User);
    var name = string.IsNullOrEmpty(user?.DisplayName) ? User.Identity.Name : user.DisplayName;
    <li class="nav-item">
        <span class="pokedex-user-label">Signed in as @name</span>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link pokedex-button pokedex-account-button" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link pokedex-button pokedex-account-button" asp-controller="Account" asp-action="Login">Sign in</a>
    </li>
}
</ul>