<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameDex</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/listAndDetails.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="pokedex-shell">
        <header class="pokedex-header">
            <nav class="navbar navbar-expand-sm navbar-dark pokedex-nav">
                <div class="container-fluid">
                    <a class="navbar-brand pokedex-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-lens" aria-hidden="true"></span>
                        <span>
                            <strong>GameDex</strong>
                            <small>Game Registry</small>
                        </span>
                    </a>
                    <div class="navbar-collapse d-inline-flex">
                        <ul class="navbar-nav pokedex-nav-list">
                        <li class="nav-item">
                                <a class="nav-link pokedex-button" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link pokedex-button" asp-controller="Games" asp-action="Index">Games</a>
                        </li>
                        <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="pokedex-screen">
            @RenderBody()
        </main>

        <footer class="pokedex-footer">
            <span class="footer-dot" aria-hidden="true"></span>
            <span>GameDex Registry &copy; 2026</span>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
